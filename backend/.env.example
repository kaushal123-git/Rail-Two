# LOCO Production Railway Platform - Backend Environment Configuration

ENVIRONMENT=development

# Database Settings (PostgreSQL 17+ in Production)
DATABASE_URL=postgresql+asyncpg://postgres:postgres@localhost:5432/loco_db
SYNC_DATABASE_URL=postgresql://postgres:postgres@localhost:5432/loco_db

# Redis Settings (Port 6379)
REDIS_URL=redis://localhost:6379/0

# Security & Cryptographic Signing
JWT_SECRET_KEY=replace_with_a_secure_random_64_char_secret_in_production
JWT_ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=60
REFRESH_TOKEN_EXPIRE_DAYS=30

# OTP Architecture
OTP_EXPIRE_MINUTES=5
OTP_MAX_ATTEMPTS=3
OTP_RESEND_COOLDOWN_SECONDS=60
OTP_RATE_LIMIT_PER_HOUR=5
OTP_PROVIDER=mock  # Options: mock, twilio, smtp

# Optional SMS / Email Delivery Providers
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_PHONE_NUMBER=

SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=
SMTP_FROM_NAME="LOCO Verification"

# Phase 2: Payment Gateway (Razorpay / Test)
PAYMENT_GATEWAY_PROVIDER=test  # "razorpay" | "test"
PAYMENT_MODE=test              # "test" | "live"
RAZORPAY_KEY_ID=rzp_test_loco2026mockkey
RAZORPAY_KEY_SECRET=loco_test_secret_key_9921
RAZORPAY_WEBHOOK_SECRET=loco_webhook_sec_8841

# Phase 2: Railway Provider Integration
RAILWAY_PROVIDER=loco_core     # "loco_core" | "uts_stub"
BOOKING_EXPIRATION_MINUTES=15
IDEMPOTENCY_EXPIRE_HOURS=24
